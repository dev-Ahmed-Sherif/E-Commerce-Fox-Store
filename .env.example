# Customer auth — Better Auth (email/password + Google/Gmail)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console → Credentials → OAuth 2.0 Client
# Authorized redirect URI (local):
#   http://localhost:3000/api/customer-auth/callback/google
# Authorized redirect URI (production):
#   https://YOUR_DOMAIN/api/customer-auth/callback/google

# MongoDB (Prisma — CustomerProfile + catalog; Better Auth customer_* collections)
# Dev (standalone local): mongodb://localhost:27017/fox-store
# Prod (Atlas replica set): mongodb+srv://USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/fox-store?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/fox-store

# Dashboard JWT auth (admin) — unchanged
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_COOKIE=fox_access_token
REFRESH_TOKEN_COOKIE=fox_refresh_token

# Optional / existing integrations
UPLOADTHING_TOKEN=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_Secret_Key=
STRIPE_WEBHOOK_SECRET=
